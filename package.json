{
  "name": "prediction-alpha-agent",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "ingest": "pnpm --filter @paa/ingest exec tsx src/index.ts",
    "signals": "pnpm --filter @paa/signals exec tsx src/index.ts",
    "narrate": "pnpm --filter @paa/narrator exec tsx src/cli.ts",
    "web": "pnpm --filter @paa/web dev",
    "dev": "pnpm -r --parallel dev",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
