# ---------- RPC ----------
RPC_URL=https://api.devnet.solana.com
# OrbitFlare（本届赞助方，可选；填了它会显著降低延迟）
ORBITFLARE_RPC_URL=

# ---------- Jupiter Prediction API ----------
# 在 https://developers.jup.ag/portal 申请
JUP_API_KEY=
JUP_PREDICTION_BASE=https://api.jup.ag/prediction/v1

# ---------- Pyth ----------
# 注意：Pyth Core 升级后 Hermes 需要 API Key
# 最新价：GET ${PYTH_HERMES_URL}/v2/updates/price/latest?ids[]=
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
PYTH_API_KEY=

# ---------- Perps ----------
# Jupiter Perps API 官方仍为 WIP，先用占位来源，后续可切 Drift / 公开数据源
PERP_FUNDING_SOURCE=placeholder

# ---------- 存储 ----------
DATA_DIR=./.data

# ---------- ingest ----------
# live 走 api.jup.ag；fixture 读 fixtures/events.sample.json，不访问网络
INGEST_SOURCE=live
# live 网络失败时回退到 fixture，并打印 WARN
INGEST_FALLBACK_FIXTURE=false

# ---------- 信号（简化模型，不追求精确）----------
# 年化波动率，用于对数正态 P(S_T > K)
SIGNAL_VOL_ANNUAL=0.6
# 到期天数
SIGNAL_HORIZON_DAYS=30
# z-score 的分母，常数，不是历史估计
SIGNAL_SIGMA_HIST=0.08

# ---------- LLM（narrator 用）----------
# OpenAI 兼容 Chat Completions：POST ${LLM_BASE_URL}/chat/completions
# 三个都要填才会调模型；缺 key 会报错并回退模板
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
